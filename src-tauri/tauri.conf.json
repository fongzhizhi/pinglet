{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinglet",
  "version": "1.4.1",
  "identifier": "com.fongzhizhi.pinglet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pinglet",
        "width": 320,
        "height": 320,
        "minWidth": 280,
        "maxWidth": 600,
        "minHeight": 200,
        "maxHeight": 800,
        "resizable": true,
        "maximizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "fongzhizhi",
    "copyright": "Copyright © 2026 fongzhizhi",
    "category": "Utility",
    "shortDescription": "Claude Code 会话状态看板",
    "longDescription": "Pinglet 是只读聚合 Claude Code 本地交互式会话的 Windows 桌面看板，提供四种状态展示、置顶小窗、托盘动画、提醒与通知弹窗。不联网，不写入 Claude 配置或会话数据。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
